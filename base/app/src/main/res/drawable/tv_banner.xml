        android:fillColor="#FFFFFFFF"
        android:pathData="M164,66 h9 v30 c0,10 6,16 14,16 c8,0 14,-6 14,-16 v-30 h9 v31 c0,15 -10,24 -23,24 c-13,0 -23,-9 -23,-24 z" />
