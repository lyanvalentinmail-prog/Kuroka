<?xml version="1.0" encoding="utf-8"?>
<!--
  Kuroka's mark: a cat's head made of two ears and a play triangle where the face would be — the
  app watches anime, and it is called after the black cat that sits on the remote.

  Drawn as a vector so the launcher icon, the splash and the TV banner are one file (108dp of
  adaptive-icon canvas, the mark inside the 72dp safe zone).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The left ear. -->
    <path
        android:fillColor="#FFF1316F"
        android:pathData="M31,34 L38.5,20.5 C39.4,18.9 41.6,18.7 42.8,20.1 L52,31 Z" />
    <!-- The right ear. -->
    <path
        android:fillColor="#FFF1316F"
        android:pathData="M77,34 L69.5,20.5 C68.6,18.9 66.4,18.7 65.2,20.1 L56,31 Z" />

    <!-- The head. -->
    <path
        android:fillColor="#FFF1316F"
        android:pathData="M54,28 C68,28 79,38.5 79,52.5 C79,68 68.5,80 54,80 C39.5,80 29,68 29,52.5 C29,38.5 40,28 54,28 Z" />

    <!-- The play triangle, knocked out of the face in the plate's own colour. -->
    <path
        android:fillColor="#FF0B0B0D"
        android:pathData="M47.5,44.5 L64,54 L47.5,63.5 Z" />
</vector>
