<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of Kuroka's goes into a backup or a device-to-device transfer: the account's tokens live
  in the keystore and cannot be moved anyway, and a library that arrives half-restored is worse
  than one the user signs into again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
